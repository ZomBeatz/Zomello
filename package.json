{
  "name": "zomello",
  "private": true,
  "version": "0.5.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "app": "tauri dev",
    "bundle": "tauri build",
    "bundle:windows": "PATH=\"$HOME/.cargo/bin:$PATH\" tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc --bundles nsis",
    "server": "npm run build && cargo build --release --manifest-path server/Cargo.toml",
    "server:docker": "docker build -t zomello-server .",
    "android": "./scripts/android-install.sh",
    "android:release": "./scripts/android-release.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-barcode-scanner": "^2.5.3",
    "@tauri-apps/plugin-clipboard-manager": "~2.5.0",
    "@tauri-apps/plugin-notification": "~2.7.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "lucide-react": "^1.53.0",
    "marked": "^18.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
