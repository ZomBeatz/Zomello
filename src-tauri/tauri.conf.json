{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zomello",
  "version": "0.1.0",
  "identifier": "com.zombeatz.zomello",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zomello",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/attachments/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Zomello: local-first kanban & planner",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "ZomBeatz Media",
    "fileAssociations": [
      {
        "ext": ["zomello"],
        "name": "Zomello board",
        "description": "Zomello board",
        "mimeType": "application/x-zomello",
        "role": "Editor"
      }
    ],
    "copyright": "\u00a9 ZomBeatz Media",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
