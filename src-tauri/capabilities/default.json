{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities for the main window",
  "windows": [
    "main",
    "board-*",
    "device-*"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "opener:default",
    "notification:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "core:window:allow-set-title",
    "opener:allow-reveal-item-in-dir",
    "allow-load-data",
    "allow-save-data",
    "allow-export-data",
    "allow-export-bytes",
    "allow-take-opened-files",
    "allow-check-server",
    "allow-find-servers",
    "allow-allow-place",
    "allow-places-read",
    "allow-places-save-boards",
    "allow-places-save-list",
    "allow-open-server-window",
    "allow-list-backups",
    "allow-read-backup",
    "allow-data-location",
    "allow-save-attachment",
    "allow-store-file-from-path",
    "allow-open-board-window",
    "allow-read-dropped-file",
    "allow-attachment-abs-path",
    "allow-list-attachments",
    "allow-delete-attachment",
    "allow-remote-status",
    "allow-remote-set-enabled",
    "allow-remote-start-pairing",
    "allow-remote-cancel-pairing",
    "allow-remote-unlink",
    "allow-remote-rename",
    "allow-fetch-calendar",
    "allow-set-background-mode",
    "allow-show-main-window",
    "allow-get-autostart",
    "allow-set-autostart",
    "allow-remote-open-firewall",
    "allow-remote-set-address",
    "allow-remote-regenerate-cert",
    "allow-remote-export-cert",
    "allow-remote-qr",
    "allow-places-save-look",
    "allow-remote-show-boards",
    "allow-linked-devices",
    "allow-linked-data",
    "allow-linked-send",
    "allow-open-device-window",
    "allow-places-save-link",
    "allow-link-ops-ack",
    "allow-store-package",
    "allow-places-send-board",
    "allow-places-take-board",
    "allow-linked-send-board",
    "allow-linked-send-private",
    "allow-linked-connected",
    "allow-device-backups",
    "allow-device-backup-read",
    "allow-device-backup-delete",
    "allow-backup-set-password",
    "allow-backup-has-password",
    "allow-backup-open",
    "allow-backup-pending"
  ]
}
